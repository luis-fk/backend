    <feeder:settings>
      <feeder:setting key="prefs_filter_recently_read" value="true"/>
      <feeder:setting key="prefs_list_show_only_titles" value="false"/>
      <feeder:setting key="pref_is_mark_as_read_on_scroll" value="true"/>
      <feeder:setting key="pref_added_feeder_news" value="true"/>
      <feeder:setting key="prefs_filter_saved" value="false"/>
      <feeder:setting key="pref_max_lines" value="10"/>
      <feeder:setting key="pref_max_item_count_per_feed" value="50"/>
      <feeder:setting key="pref_open_links_with" value="2"/>
      <feeder:setting key="pref_img_show_thumbnails" value="true"/>
      <feeder:setting key="pref_feed_item_style" value="CARD"/>
      <feeder:setting key="pref_default_open_item_with" value="0"/>
      <feeder:setting key="prefs_filter_read" value="true"/>
    </feeder:settings>
