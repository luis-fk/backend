# Local settings: make setup copies this file to .env when there is none. The
# databases are the ones docker-compose.yaml creates.
ENVIRONMENT=development
SECRET_KEY=local-only-secret-key
# The frontend's .env needs the same value.
API_TOKEN_SECRET=local-only-api-token-secret-for-development
SERVER_URL=localhost
NGROK_URL=localhost
FRONT_END_URL=http://localhost:3000

AUTH_DATABASE_URL=postgres://postgres:password@localhost:5432/default_db
PLANTS_DATABASE_URL=postgres://postgres:password@localhost:5432/plants_db
POLITICAL_CULTURE_DATABASE_URL=postgres://postgres:password@localhost:5432/political_culture_db
CFFLCH_DATABASE_URL=postgres://postgres:password@localhost:5432/cfflch_db
NEWS_PODCAST_DATABASE_URL=postgres://postgres:password@localhost:5432/news_podcast_db

# Without real keys the site and its data work, but the chats, the PDF uploads, the
# weather of new readings and the searches fail. The chats build their OpenAI clients on import,
# so OPENAI_API_KEY can't be empty.
OPENAI_API_KEY=your-openai-key
OPEN_WEATHER_API_KEY=your-openweather-key
# TAVILY_API_KEY=
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ADMIN_CHAT_ID=
