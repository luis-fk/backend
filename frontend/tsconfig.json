{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/plants/*": ["./src/app/[lang]/plants/*"],
      "@/plants/components/*": ["./src/app/[lang]/plants/components/*"],
      "@/plants/css/*": ["./src/app/[lang]/plants/css/*"],
      "@/plants/actions/*": ["./src/app/[lang]/plants/actions/*"],

      "@/political-culture/*": ["./src/app/[lang]/political-culture/*"],
      "@/political-culture/components/*": [
        "./src/app/[lang]/political-culture/components/*"
      ],
      "@/political-culture/css/*": ["./src/app/[lang]/political-culture/css/*"],
      "@/political-culture/actions/*": [
        "./src/app/[lang]/political-culture/actions/*"
      ],
      "@/log/*": ["./src/app/api/log/*"],

      "@/cfflch/*": ["./src/app/[lang]/cfflch/*"],
      "@/cfflch/components/*": ["./src/app/[lang]/cfflch/components/*"],
      "@/cfflch/css/*": ["./src/app/[lang]/cfflch/css/*"],
      "@/cfflch/hooks/*": ["./src/app/[lang]/cfflch/hooks/*"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
